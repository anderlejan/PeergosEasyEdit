# Settings for the build and test tools (tools/env.py). Copy to .env and adjust; .env is never committed.
# The app itself has no settings or secrets – it runs inside Peergos and keeps its data there.

# port of the mock Peergos server used by the browser tests
MOCK_PORT=8791

# local throw-away Peergos server for tests/peergos/ (never a real account)
PEERGOS_JAR=_local/peergos/Peergos.jar
PEERGOS_URL=http://localhost:8777
PEERGOS_TEST_USER=testuser
PEERGOS_TEST_PASSWORD=change-me-to-a-random-test-password

# where tools/make_release.py writes the release files
RELEASE_OUT=Releases
